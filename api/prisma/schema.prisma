/// Site animasyon kütüphanesi — sesli oda giriş/çıkış/koltuk efektleri.
model SiteAnimation {
  id            String   @id
  name          String
  category      String
  membership    String   @default("normal")
  animationType String   @default("native") @map("animation_type")
  assetUrl      String?  @map("asset_url")
  previewUrl    String?  @map("preview_url")
  soundUrl      String?  @map("sound_url")
  durationMs    Int      @default(3000) @map("duration_ms")
  priority      Int      @default(50)
  rarity        String   @default("common")
  context       String   @default("voice_room")
  anchor        String   @default("TOP_LEFT")
  scale         Float    @default(1)
  cooldownMs    Int      @default(0) @map("cooldown_ms")
  isActive      Boolean  @default(true) @map("is_active")
  description   String?
  previewMp4Key String?  @map("preview_mp4_key")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  defaults    SiteAnimationDefault[]
  assignments SiteAnimationUserAssignment[]

  @@index([category, membership, isActive])
  @@map("site_animations")
}

/// Üyelik seviyesine göre varsayılan giriş animasyonu.
model SiteAnimationDefault {
  id          String        @id @default(cuid())
  membership  String        @unique
  animationId String        @map("animation_id")
