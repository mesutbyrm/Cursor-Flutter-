generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Paylaşılan veritabanı: web ve Flutter aynı Prisma şeması / tabloları kullanır.
model User {
  id              String         @id @default(cuid())
  email           String         @unique
  passwordHash    String
  displayName     String?
  username        String?        @unique
  phone           String?
  birthDate       DateTime?
  birthTime       String?
  language        String         @default("tr")
  googleId        String?        @unique
  tiktokId        String?        @unique
  bio             String?
  avatarUrl       String?
  coverUrl        String?
  coins           Int            @default(500)
  cfcBalance      Int            @default(0)
  membership      String         @default("basic")
  membershipExpiresAt DateTime?
  role            String         @default("user")
  followerCount   Int            @default(0)
  followingCount  Int            @default(0)
  referralCode          String?        @unique
  referredByUserId      String?
  referredBy            User?          @relation("UserReferrals", fields: [referredByUserId], references: [id], onDelete: SetNull)
  referrals             User[]         @relation("UserReferrals")
  referralJoinedAt      DateTime?
  referralStatus        String         @default("active")
  isFoundingUser        Boolean        @default(false)
  referralFraudScore    Int            @default(0)
  referralDebtJeton     Int            @default(0)
  emailVerifiedAt DateTime?
  emailVerificationCode String?
  emailVerificationExpiresAt DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  refreshTokens   RefreshToken[]
  followers       Follow[]       @relation("UserFollowers")
  following       Follow[]       @relation("UserFollowing")
  socialPosts         SocialPost[]
  cfcPaymentRequests  CfcPaymentRequest[]
  conversationsA      Conversation[] @relation("ConversationUserA")
  conversationsB      Conversation[] @relation("ConversationUserB")
  fortunes              UserFortune[]
  favorites             UserFavorite[]
  shortVideos           ShortVideo[]
  shortVideoComments    ShortVideoComment[]
  fortuneTeller  FortuneTeller?
  referralCommissionsEarned ReferralCommissionLedger[] @relation("ReferrerCommissions")
  referralCommissionsSource ReferralCommissionLedger[] @relation("ReferredCommissions")

  // Feature 42: Abonelik
  subscription Subscription?
  paymentMethods PaymentMethod[]

  // Feature 43: Serileri ve Başarılar
  streak UserStreak?
  achievements UserAchievement[]
  level UserLevel?

  // Feature 44: Bildirimler
  notificationPreferences NotificationPreference?
  notifications Notification[]

  // Feature 37: AI Copilot
  aiCopilotSuggestions AICopilot[]
  aiCopilotHistory AICopilotHistory[]

  // Feature 38: Fal Eşleştirme
  matchesAsUser1 FortuneMatch[] @relation("FortuneMatchUser1")
  matchesAsUser2 FortuneMatch[] @relation("FortuneMatchUser2")
  matchViews FortuneMatchView[]

  // Feature 39: Analitik
  analytics UserAnalytics?
  analyticsSnapshots AnalyticsSnapshot[]

  // Feature 40: Sesli Fal
  voiceFortunes VoiceFortune[]

  // Phase 3 relations (26-36)
  following UserFollow[] @relation("UserFollowingRel")
  followers UserFollow[] @relation("UserFollowersRel")
  blocking UserBlock[] @relation("UserBlockingRel")
  blocked UserBlock[] @relation("UserBlockedRel")

  dmConversationsAsP1 DirectMessageConversation[] @relation("DMConvPart1")
  dmConversationsAsP2 DirectMessageConversation[] @relation("DMConvPart2")
  directMessages DirectMessage[]

  stories UserStory[]
  storyViews StoryView[]
  storyReactions StoryReaction[]

  shareSettings ShareSettings?
  recommendationsReceived UserRecommendation[] @relation("UserRecommendationsReceived")
  recommendationsMade UserRecommendation[] @relation("UserRecommendationsMade")

  preferences UserPreferences?
  animationConfig AnimationConfig?
  performanceMetrics PerformanceMetrics[]

  twoFactorAuth TwoFactorAuth?
  twoFactorSessions TwoFactorSession[]

  accessibilitySettings AccessibilitySettings?

  voiceSessions VoiceSession[]
  agoraTokens AgoraToken[]
  voiceRoomRoles VoiceRoomRole[]
  userVoiceStats UserVoiceStats?
  roomLeaderboards RoomLeaderboard[]

  roomActivityLogs RoomActivityLog[]
  roomVisits RoomVisit[]
  roomFavorites RoomFavorite[]
  userBadges UserBadge[]

  roomRecordings RoomRecording[]

  streamViewerSessions StreamViewerSession[]
  streamModerationActionsTarget StreamModerationLog[] @relation("StreamModerationsTarget")
  streamModerationActionsMod StreamModerationLog[] @relation("StreamModerationsModerator")
  streamReportedMessages ReportedStreamMessage[] @relation("StreamReportedMessages")
  streamMessageReports ReportedStreamMessage[] @relation("StreamMessageReporters")
  streamVipViewers StreamVipViewer[]

  @@index([referredByUserId])
  @@index([referralCode])
}

/// Mobil / web fal geçmişi kaydı.
model UserFortune {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type           String
  slug           String?
  question       String?
  answer         String?
  summary        String?
  detail         String?
  imageUrl       String?
  fortuneText    String?  @db.Text
  visualAnalysis String?  @db.Text
  luckyNumber    Int?
  luckyColor     String?
  likesCount     Int      @default(0)
  commentsCount  Int      @default(0)
  createdAt      DateTime @default(now())
  socialPosts    SocialFortunePost[]

  // Phase 2 relations
  aiCopilots AICopilot[]
  voiceFortunes VoiceFortune[]

  @@index([userId, createdAt])
}

/// Fal açılışının sosyal akış kaydı (otomatik paylaşım).
model SocialFortunePost {
  id        String      @id @default(cuid())
  userId    String
  fortuneId String
  fortune   UserFortune @relation(fields: [fortuneId], references: [id], onDelete: Cascade)
  postId    String?     @unique
  post      SocialPost? @relation(fields: [postId], references: [id], onDelete: SetNull)
  postText  String      @db.Text
  createdAt DateTime    @default(now())

  @@index([userId, createdAt])
  @@index([fortuneId])
}

/// Kullanıcı favorileri (profil, gönderi, fal, içerik linki).
model UserFavorite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String
  targetId   String
  title      String?
  url        String?
  imageUrl   String?
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId, createdAt])
}

model SocialPost {
  id             String   @id @default(cuid())
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  caption        String?
  mediaUrl       String?
  postType       String   @default("text")
  fortuneType    String?
  fortuneId      String?
  isAutoShare    Boolean  @default(false)
  fortuneCount   Int      @default(0)
  viewCount      Int      @default(0)
  likesCount     Int      @default(0)
  commentsCount  Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  likes          SocialPostLike[]
  comments       SocialPostComment[]
  fortuneLink    SocialFortunePost?

  @@index([authorId])
  @@index([createdAt])
  @@index([postType, createdAt])
  @@index([fortuneId])
}

model SocialPostLike {
  id        String     @id @default(cuid())
  postId    String
  userId    String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, userId])
  @@index([postId])
  @@index([userId])
}

model SocialPostComment {
  id        String     @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime   @default(now())
  post      SocialPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followingId])
}

model RefreshToken {
  id         String   @id @default(cuid())
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  deviceLabel    String?
  devicePlatform String?
  lastSeenAt     DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

/// Hediye kataloğu — platform (mobile/web/all) ve rarity ile filtrelenir.
model Gift {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  icon          String
  animation     String?
  animationType String   @default("lottie")
  price         Int
  rarity        String   @default("common")
  platform      String   @default("all")
  sound         String?
  sortOrder     Int      @default(0)
  enabled       Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  events        GiftEvent[]

  @@index([platform, enabled, sortOrder])
  @@index([rarity])
}

/// Canlı yayın / oda hediye işlemleri.
model GiftEvent {
  id           String   @id @default(cuid())
  giftId       String
  gift         Gift     @relation(fields: [giftId], references: [id], onDelete: Restrict)
  senderId     String?
  senderName   String
  receiverId   String?
  receiverName String
  streamId     String?
  roomId       String?
  quantity     Int      @default(1)
  coinCost     Int
  combo        Int      @default(1)
  platform     String   @default("mobile")
  roomType     String?
  receiverGross Int?
  receiverNet   Int?
  ownerGross    Int?
  ownerNet      Int?
  siteAmount    Int?
  createdAt    DateTime @default(now())

  @@index([streamId, createdAt])
  @@index([roomId, createdAt])
  @@index([senderId, createdAt])
  @@index([receiverId, createdAt])
}

/// CFC ödeme ayarları (admin paneli).
model CfcSettings {
  id                   String   @id @default("default")
  cfcWhatsappNumber    String   @default("")
  cfcPaparaAddress     String   @default("")
  cfcBankName          String?
  cfcBankIban          String   @default("")
  cfcBankAccountHolder String?
  cfcTlRate            Float    @default(1)
  cfcMinAmount         Int      @default(10)
  updatedAt            DateTime @updatedAt
}

/// CFC veya jeton yükleme talebi.
model CfcPaymentRequest {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestType   String   @default("cfc")
  amount        Int
  method        String
  packageId     String?
  packageTitle  String?
  coins         Int?
  priceTry      Float?
  senderInfo    String?
  notes         String?
  receiptUrl    String?
  username      String?
  status        String   @default("pending")
  reviewedBy    String?
  reviewNote    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId, status])
  @@index([status, createdAt])
  @@index([requestType, status])
}

/// Ödeme işlemleri denetim kaydı.
model PaymentAuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  userId    String
  requestId String
  action    String
  detail    String?
  createdAt DateTime @default(now())

  @@index([requestId, createdAt])
  @@index([userId, createdAt])
}

/// FCM push token (mobil).
model DevicePushToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  platform  String   @default("unknown")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// İki kullanıcı arası DM sohbeti.
model Conversation {
  id          String   @id @default(cuid())
  userAId     String
  userBId     String
  lastMessage String?
  unreadForA  Int      @default(0)
  unreadForB  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userA       User     @relation("ConversationUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User     @relation("ConversationUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages    DirectMessage[]

  @@unique([userAId, userBId])
  @@index([updatedAt])
}

model DirectMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  createdAt      DateTime     @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

/// Uygulama / site bildirimleri.
model AppNotification {
  id         String   @id @default(cuid())
  userId     String?
  title      String
  body       String?
  type       String   @default("system")
  data       String?
  targetPath String?
  targetId   String?
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([userId, read, createdAt])
  @@index([createdAt])
}

/// PK (Battle) oturumu — sesli oda veya canlı yayın.
model PKBattle {
  id                  String          @id @default(cuid())
  battleType          String
  voiceRoomId         String?
  opponentVoiceRoomId String?
  liveStreamId        String?
  opponentLiveStreamId String?
  challengerId        String
  opponentId          String?
  status              String          @default("pending")
  startTime           DateTime?
  endTime             DateTime?
  winnerId            String?
  challengerScore     Int             @default(0)
  opponentScore       Int             @default(0)
  durationSeconds     Int             @default(300)
  targetScore         Int             @default(150000)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  participants        PKParticipant[]
  gifts               PKGift[]
  result              PKResult?

  @@index([battleType, status])
  @@index([voiceRoomId, status])
  @@index([opponentVoiceRoomId, status])
  @@index([liveStreamId, status])
  @@index([opponentLiveStreamId, status])
  @@index([challengerId, createdAt])
  @@index([opponentId, createdAt])
}

/// PK katılımcısı (challenger / opponent tarafı).
model PKParticipant {
  id          String   @id @default(cuid())
  battleId    String
  battle      PKBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  userId      String
  side        String
  roomId      String?
  streamId    String?
  score       Int      @default(0)
  winStreak   Int      @default(0)
  displayName String?
  avatarUrl   String?
  createdAt   DateTime @default(now())

  @@unique([battleId, side])
  @@index([userId])
  @@index([roomId])
  @@index([streamId])
}

/// PK sırasında gönderilen hediye → puan kaydı.
model PKGift {
  id          String   @id @default(cuid())
  battleId    String
  battle      PKBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  giftEventId String?
  senderId    String?
  senderName  String
  side        String
  giftSlug    String
  giftName    String?
  quantity    Int      @default(1)
  points      Int
  createdAt   DateTime @default(now())

  @@index([battleId, createdAt])
  @@index([senderId, createdAt])
}

/// PK sonucu — geçmiş ve şampiyon rozeti.
model PKResult {
  id                   String   @id @default(cuid())
  battleId             String   @unique
  battle               PKBattle @relation(fields: [battleId], references: [id], onDelete: Cascade)
  winnerId             String?
  winnerSide           String?
  challengerFinalScore Int
  opponentFinalScore   Int
  championBadge        Boolean  @default(true)
  createdAt            DateTime @default(now())

  @@index([winnerId, createdAt])
}

/// TikTok tarzı kısa videolar — dosyalar Cloudflare R2/CDN; burada yalnızca metadata.
model ShortVideo {
  id            String              @id @default(cuid())
  userId        String
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  videoUrl      String
  thumbnailUrl  String?
  description   String?
  durationSec   Float?
  viewsCount    Int                 @default(0)
  likesCount    Int                 @default(0)
  commentsCount Int                 @default(0)
  sharesCount Int                 @default(0)
  savesCount  Int                 @default(0)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
  likes         ShortVideoLike[]
  comments      ShortVideoComment[]
  views         ShortVideoView[]
  saves         ShortVideoSave[]

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("short_videos")
}

model ShortVideoLike {
  id        String     @id @default(cuid())
  videoId   String
  userId    String
  video     ShortVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([videoId, userId])
  @@index([videoId])
  @@index([userId])
}

model ShortVideoComment {
  id        String     @id @default(cuid())
  videoId   String
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  content   String
  video     ShortVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@index([videoId, createdAt])
  @@index([userId])
}

model ShortVideoSave {
  id        String     @id @default(cuid())
  videoId   String
  userId    String
  video     ShortVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([videoId, userId])
  @@index([videoId])
  @@index([userId])
  @@map("short_video_saves")
}

/// Kullanıcı başına tek izlenme sayımı (≥3 sn).
model ShortVideoView {
  id        String     @id @default(cuid())
  videoId   String
  userId    String
  video     ShortVideo @relation(fields: [videoId], references: [id], onDelete: Cascade)
  createdAt DateTime   @default(now())

  @@unique([videoId, userId])
  @@index([videoId])
}

/// Oda şarkı kuyruğu (SongQueueService — FIFO).
model RoomSongQueue {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  username  String?
  videoId   String
  title     String
  thumbnail String?
  duration  String?
  channel   String?
  status    String   @default("queued")
  position  Int      @default(0)
  createdAt DateTime @default(now())

  @@index([roomId, status, position])
  @@map("room_song_queue")
}

/// Oda şu an çalan şarkı (senkron otorite).
model RoomCurrentSong {
  id         String    @id @default(cuid())
  roomId     String    @unique
  queueId    String?
  videoId    String?
  title      String?
  thumbnail  String?
  durationSec Int?
  channel    String?
  ownerId    String?
  ownerName  String?
  startedAt  DateTime?
  pausedAt   DateTime?
  paused     Boolean   @default(false)
  elapsedMs  Int       @default(0)
  updatedAt  DateTime  @updatedAt

  @@map("room_current_song")
}

/// Oda şarkı geçmişi — kim istedi, kaç kez çalındı.
model RoomSongHistory {
  id            String    @id @default(cuid())
  roomId        String
  queueId       String?
  videoId       String
  title         String
  thumbnail     String?
  durationSec   Int?
  channel       String?
  requestedById String
  requestedBy   String?
  playCount     Int       @default(1)
  playedAt      DateTime  @default(now())
  finishedAt    DateTime?
  skipped       Boolean   @default(false)

  @@index([roomId, playedAt])
  @@index([videoId])
  @@map("room_song_history")
}

/// Sesli oda müzik kuyruğu — oda başına sıralı şarkı istekleri.
model MusicQueue {
  id         String   @id @default(cuid())
  roomId     String
  userId     String
  username   String?
  artist     String?
  songName   String
  youtubeId  String
  duration   String?
  thumbUrl   String?
  status     String   @default("queued")
  createdAt  DateTime @default(now())

  @@index([roomId, status, createdAt])
  @@map("music_queue")
}

/// Müzik oynatıcı işlem günlüğü (istek, jeton, oynatma, yetkisiz deneme).
model MusicActionLog {
  id        String   @id @default(cuid())
  roomId    String
  userId    String?
  username  String?
  action    String
  metadata  String?
  createdAt DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([userId, createdAt])
  @@map("music_action_logs")
}

/// Sesli oda türü — gelir ve özellik matrisi.
enum RoomType {
  FREE
  NORMAL
  VIP
}

/// Kalıcı sesli oda kaydı (canlifal.com ChatRoom / VoiceRoom ile uyumlu).
model VoiceRoom {
  id               String   @id @default(cuid())
  slug             String   @unique
  nameTr           String
  descTr           String?
  icon             String?
  backgroundImage  String?
  ownerId          String
  roomType         RoomType @default(NORMAL)
  maxUsers         Int      @default(100)
  isActive         Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([roomType, isActive])
  @@index([ownerId])
  @@map("voice_rooms")
}

/// Sesli oda kullanıcı rolleri: owner, moderator, speaker, listener
model VoiceRoomRole {
  id String @id @default(cuid())
  roomId String
  userId String
  user User @relation("VoiceRoomRoles", fields: [userId], references: [id], onDelete: Cascade)

  role String @default("listener")  // "owner" | "moderator" | "speaker" | "listener"
  permissions String[]  // ["mute_others", "kick", "manage_queue", "manage_roles"]
  assignedAt DateTime @default(now())
  assignedBy String?  // Kimse tarafından atanmış

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([roomId, role])
  @@index([userId, createdAt])
  @@map("voice_room_roles")
}

/// Kullanıcı sesli oda istatistikleri
model UserVoiceStats {
  id String @id @default(cuid())
  userId String
  user User @relation("UserVoiceStats", fields: [userId], references: [id], onDelete: Cascade)

  totalMinutesSpeaking Int @default(0)  // Toplam konuşma dakikası
  totalMinutesListening Int @default(0)  // Toplam dinleme dakikası
  totalRoomsJoined Int @default(0)  // Katıldığı oda sayısı
  favoriteRoomId String?  // En sık ziyaret edilen oda

  engagementScore Int @default(0)  // Katılım puanı (algoritma tabanlı)
  lastActivityAt DateTime?  // Son aktivite zamanı

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId])
  @@map("user_voice_stats")
}

/// Oda leaderboard: Konuşan kullanıcıları sırala
model RoomLeaderboard {
  id String @id @default(cuid())
  roomId String
  userId String
  user User @relation("RoomLeaderboards", fields: [userId], references: [id], onDelete: Cascade)

  speakingDuration Int @default(0)  // Dakika
  messagesCount Int @default(0)
  giftsReceived Int @default(0)
  rank Int  // Oda içindeki sıra
  weeklyRank Int?  // Haftalık sıra

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([roomId, userId])
  @@index([roomId, rank])
  @@index([roomId, weeklyRank])
  @@index([userId, createdAt])
  @@map("room_leaderboards")
}

/// Sesli oda gelir ayarları (admin paneli).
model VoiceRoomSettings {
  id                     String   @id @default("default")
  giftReceiverPercent    Int      @default(70)
  roomOwnerPercent       Int      @default(30)
  siteCommissionPercent  Int      @default(50)
  musicOwnerPercent      Int      @default(50)
  musicSitePercent       Int      @default(50)
  vipMusicOwnerPercent   Int      @default(70)
  vipMusicSitePercent    Int      @default(30)
  musicRequestCost       Int      @default(10)
  freeRoomMaxUsers       Int      @default(15)
  normalRoomMaxUsers     Int      @default(100)
  vipRoomMaxUsers        Int      @default(500)
  updatedAt              DateTime @updatedAt

  @@map("voice_room_settings")
}

/// Hediye ve müzik jeton dağıtımı denetim kaydı.
model VoiceRoomFinanceAuditLog {
  id              String   @id @default(cuid())
  roomId          String?
  roomType        String?
  transactionType String
  actorId         String?
  totalAmount     Int
  receiverId      String?
  receiverGross   Int?
  receiverNet     Int?
  ownerId         String?
  ownerGross      Int?
  ownerNet        Int?
  siteAmount      Int      @default(0)
  giftEventId     String?
  metadata        String?
  createdAt       DateTime @default(now())

  @@index([roomId, createdAt])
  @@index([transactionType, createdAt])
  @@index([actorId, createdAt])
  @@map("voice_room_finance_audit_log")
}
/// Referans / ajans komisyon ayarları (admin paneli).
model ReferralSettings {
  id                              String   @id @default("default")
  livePlatformCommissionRate      Int      @default(50)
  voiceRoomPlatformCommissionRate Int      @default(50)
  falPlatformCommissionRate       Int      @default(50)
  otherPlatformCommissionRate     Int      @default(50)
  referralCommissionRate          Int      @default(5)
  normalReferralMonthlyCap        Int      @default(10000)
  foundingUserReferralMonthlyCap  Int      @default(25000)
  lifetimeReferralCap             Int      @default(100000)
  foundingUserLimit               Int      @default(1000)
  foundingUserEnabled             Boolean  @default(true)
  pendingHours                    Int      @default(24)
  fraudHoldThreshold              Int      @default(61)
  fraudBlockThreshold             Int      @default(81)
  fraudReviewThreshold            Int      @default(31)
  updatedAt                       DateTime @updatedAt

  @@map("referral_settings")
}

/// Referans komisyon defteri — immutable audit.
model ReferralCommissionLedger {
  id                 String    @id @default(cuid())
  transactionId      String
  referrerUserId     String
  referrer           User      @relation("ReferrerCommissions", fields: [referrerUserId], references: [id], onDelete: Cascade)
  referredUserId     String
  referred           User      @relation("ReferredCommissions", fields: [referredUserId], references: [id], onDelete: Cascade)
  sourceType         String
  sourceId           String
  grossJeton         Int
  beneficiaryShare   Int
  platformShare      Int
  referralRate       Int
  referralCommission Int
  platformNet        Int
  status             String    @default("PENDING")
  fraudScore         Int       @default(0)
  cappedAmount       Int       @default(0)
  metadata           String?
  createdAt          DateTime  @default(now())
  availableAt        DateTime?
  reversedAt         DateTime?
  reverseReason      String?

  @@unique([transactionId, referrerUserId])
  @@index([referrerUserId, createdAt])
  @@index([referredUserId, createdAt])
  @@index([sourceType, sourceId])
  @@index([status, createdAt])
  @@map("referral_commission_ledger")
}

/// Referans borç mahsup kaydı (iade/chargeback sonrası).
