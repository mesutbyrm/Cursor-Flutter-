  @@map("site_animation_defaults")
}

/// Kullanıcıya özel animasyon slot ataması.
model SiteAnimationUserAssignment {
  id          String         @id @default(cuid())
  userId      String         @map("user_id")
  slot        String
  animationId String?        @map("animation_id")
  animation   SiteAnimation? @relation(fields: [animationId], references: [id], onDelete: SetNull)
  expiresAt   DateTime?      @map("expires_at")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  @@unique([userId, slot])
  @@index([userId])
  @@map("site_animation_user_assignments")
}

